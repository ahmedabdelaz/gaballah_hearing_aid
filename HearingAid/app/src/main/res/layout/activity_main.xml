<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    ============================================================
    Dark-themed audiogram-style UI.
    Layout: ScrollView → LinearLayout (vertical)
      1. Header bar with title + latency
      2. Start/Stop button
      3. 10-band EQ line chart (draggable nodes)
      4. Bypass toggle
      5. Master Gain seekbar
      6. Noise Gate seekbar
      7. Compressor Threshold seekbar
      8. Compressor Ratio seekbar
    ============================================================
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🦻 Hearing Aid Pro"
                android:textColor="#E0E0FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latency: — ms"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ── Start / Stop button ────────────────────────────── -->
        <Button
            android:id="@+id/btn_start_stop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶  Start Hearing Aid"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#00897B"
            android:layout_marginBottom="16dp" />

        <!-- ── EQ graph section ───────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frequency Response (drag bands)"
            android:textColor="#AAAACC"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <!-- MPAndroidChart LineChart — renders the EQ curve -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_eq"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp" />

        <!-- ── Bypass toggle ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A30"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bypass (pass-through)"
                android:textColor="#CCCCFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_bypass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <!-- ── Master Gain ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A30"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_master_gain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Master Gain: +0 dB"
                android:textColor="#CCCCFF"
                android:textSize="14sp"
                android:paddingBottom="6dp" />

            <SeekBar
                android:id="@+id/seek_master_gain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-20 dB ◄──────────────────► +40 dB"
                android:textColor="#556677"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ── Noise Gate ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A30"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_noise_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noise Gate: -50 dB"
                android:textColor="#CCCCFF"
                android:textSize="14sp"
                android:paddingBottom="6dp" />

            <SeekBar
                android:id="@+id/seek_noise_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More sensitive ◄──────────────► Less sensitive"
                android:textColor="#556677"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ── Compressor Threshold ───────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A30"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_comp_thresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compressor Threshold: -30 dB"
                android:textColor="#CCCCFF"
                android:textSize="14sp"
                android:paddingBottom="6dp" />

            <SeekBar
                android:id="@+id/seek_comp_thresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── Compressor Ratio ───────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A30"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_comp_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compression Ratio: 3.0:1"
                android:textColor="#CCCCFF"
                android:textSize="14sp"
                android:paddingBottom="6dp" />

            <SeekBar
                android:id="@+id/seek_comp_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1:1 (no compression) ◄──────────► 10:1 (heavy)"
                android:textColor="#556677"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ── Info footer ────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Use with earphones for best results. High gain may cause feedback with open speakers."
            android:textColor="#886644"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>
